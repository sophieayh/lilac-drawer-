# Same Postgres database as the main Lilac Drawer site — this app reads
# and writes the same tables (users, posts, products, page_views), it just
# doesn't own migrations (the main site's `npm run db:migrate` does).
DATABASE_URL="postgresql://user:password@host/dbname"

# Must match the main site's BETTER_AUTH_SECRET so both apps trust the same
# session-signing key (accounts are shared — one `user` table for both).
BETTER_AUTH_SECRET="paste the same value used in the main site's .env.local"
# This app's own URL (it's a separate deployment from the public site).
BETTER_AUTH_URL="http://localhost:3001"

# Used for the "View live site" link in the sidebar. Optional — defaults to
# the production URL if unset.
PUBLIC_SITE_URL="http://localhost:3000"

# Vercel Blob — powers the photo upload button on the Articles and Products
# forms (POST /api/upload). Create a Blob store from your Vercel project's
# Storage tab; it adds this variable automatically. For local dev, run
# `vc env pull` or paste the token from that same Storage tab.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
