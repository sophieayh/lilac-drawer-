# Postgres connection string.
#
# Local development: point this at a local Postgres instance, e.g.
#   DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/lilacdrawer"
#
# Production (Vercel): create a free Neon Postgres database — either through
# the Vercel dashboard's Storage tab ("Create Database" → Postgres, which is
# powered by Neon), or directly at https://neon.tech — then paste its
# connection string here and add it as an Environment Variable in your
# Vercel project settings (Settings → Environment Variables).
DATABASE_URL="postgresql://user:password@host/dbname"

# Authentication (Better Auth) — required for the Community section
# (posting, commenting, liking, reposting all need a signed-in account).
#
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="paste output of the command above"
# Your real production domain in production; localhost for local dev.
BETTER_AUTH_URL="http://localhost:3000"
